# Porta exposta no host e usada pelo servidor no desenvolvimento local.
PORT_SERVER=3333

# Porta do MongoDB exposta no host.
MONGODB_PORT=27017

# Banco e credenciais de desenvolvimento da stack Docker.
MONGODB_DATABASE=ecoweb
MONGODB_USERNAME=ecoweb
MONGODB_PASSWORD=ecoweb_dev_password
MONGODB_AUTH_SOURCE=admin

# URL usada quando a API roda diretamente no host.
# No Docker Compose, ela é substituída automaticamente pelo hostname `mongodb`.
MONGODB_URL=mongodb://localhost:27017/ecoweb?authSource=admin

# Nível mínimo dos logs JSON em produção (trace, debug, info, warn, error ou fatal).
LOG_LEVEL=info
